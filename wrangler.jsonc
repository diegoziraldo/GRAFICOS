{
  // IMPORTANTE: "name" tiene que ser IGUAL al nombre de tu Worker en Cloudflare
  // (lo ves arriba en el panel de tu proyecto, en Workers & Pages).
  "name": "graficos",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",

  // La app compilada (npm run build deja todo en ./dist)
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Tu base D1 existente. Completá estos dos datos (los ves en
  // Workers & Pages > D1 > tu base). El binding tiene que llamarse DB.
"d1_databases": [
  {
    "binding": "DB",
    "database_name": "8262aeee-f264-49d9-b0b9-43fd783af8df",
    "database_id": "8262aeee-f264-49d9-b0b9-43fd783af8df"
  }
]
}
